source leaprc.protein.ff14SB
source leaprc.gaff2
source leaprc.water.tip3p

PHN = loadmol2 ../params/phenanthrene_docked.mol2
loadamberparams ../params/phenanthrene_docked.frcmod

rec = loadpdb ../complexes/PahP_noH.pdb
complex = combine {rec PHN}

charge complex
solvatebox complex TIP3PBOX 12.0
addions complex Na+ 0
addions complex Cl- 0

saveamberparm complex phenanthrene_complex.prmtop phenanthrene_complex.inpcrd
savepdb complex phenanthrene_complex.pdb
quit
