{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOCKING_RESULT",
  "type": "object",
  "required": ["schema_version","tool_name","branch","team_members","software_version",
    "date_completed","input_commit_hash","score_direction","receptor_prep_method",
    "ligand_prep_method","docking_parameters","results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool_name": {"type": "string"},
    "branch": {"type": "string", "pattern": "^tool/"},
    "team_members": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "software_version": {"type": "string"},
    "date_completed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "input_commit_hash": {"type": "string", "minLength": 7},
    "score_direction": {"type": "string", "enum": ["lower_is_better","higher_is_better"]},
    "receptor_prep_method": {"type": "string"},
    "ligand_prep_method": {"type": "string"},
    "docking_parameters": {"type": "object"},
    "hardware": {"type": "string"},
    "runtime_total_sec": {"type": ["number","null"]},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_id","ligand_id","docking_score","score_unit","rank_within_tool","pose_file","status"],
        "properties": {
          "target_id": {"type": "string", "enum": ["PahP","PahS"]},
          "ligand_id": {"type": "string"},
          "pubchem_cid": {"type": ["string","null"]},
          "docking_score": {"type": ["number","null"]},
          "score_unit": {"type": "string"},
          "rank_within_tool": {"type": ["integer","null"]},
          "pose_file": {"type": ["string","null"]},
          "runtime_sec": {"type": ["number","null"]},
          "status": {"type": "string", "enum": ["ok","failed"]},
          "failure_reason": {"type": ["string","null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "failed_cases": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
